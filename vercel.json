{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Permissions-Policy", "value": "camera=(self), microphone=(self), gyroscope=(self), accelerometer=(self), magnetometer=(self)" },
        { "key": "Feature-Policy", "value": "camera 'self'; microphone 'self'; gyroscope 'self'; accelerometer 'self'" }
      ]
    },
    {
      "source": "/mediapipe/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800, immutable" }]
    }
  ]
}
