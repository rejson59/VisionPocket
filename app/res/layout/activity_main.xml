<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <android.opengl.GLSurfaceView
        android:id="@+id/gl_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>

    <LinearLayout
        android:id="@+id/onboarding"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#F20B0B14"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingLeft="64dp"
        android:paddingRight="64dp">

        <TextView
            android:id="@+id/tv_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/onboarding_title"
            android:textColor="#FFFFFF"
            android:textSize="34sp"
            android:textStyle="bold"
            android:letterSpacing="0.08"/>

        <TextView
            android:id="@+id/tv_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/onboarding_subtitle"
            android:textColor="#8FA7E8"
            android:textSize="16sp"/>

        <TextView
            android:id="@+id/tv_desc"
            android:layout_width="560dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center"
            android:text="@string/onboarding_desc"
            android:textColor="#B9C2D8"
            android:textSize="14sp"
            android:lineSpacingExtra="4dp"/>

        <Button
            android:id="@+id/btn_start"
            android:layout_width="300dp"
            android:layout_height="64dp"
            android:layout_marginTop="28dp"
            android:background="#5B8DEF"
            android:text="@string/btn_start_vr"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold"/>

        <Button
            android:id="@+id/btn_no_camera"
            android:layout_width="300dp"
            android:layout_height="48dp"
            android:layout_marginTop="12dp"
            android:background="#2A2D40"
            android:text="@string/btn_no_camera"
            android:textColor="#B9C2D8"
            android:textSize="14sp"/>

        <TextView
            android:id="@+id/tv_note"
            android:layout_width="560dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:gravity="center"
            android:text="@string/onboarding_note"
            android:textColor="#6E7690"
            android:textSize="11sp"/>
    </LinearLayout>
</FrameLayout>
